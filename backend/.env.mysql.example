PORT=5000

# JWT Secret for authentication (generate a secure random string)
JWT_SECRET=replace_with_a_secure_random_string

# Node environment
NODE_ENV=development

# MySQL Database Configuration
DB_DIALECT=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=grocery_db_dev
DB_PORT=3306

# Optional: Path to a file containing the database password
# DB_PASSWORD_FILE=/path/to/password/file

# Optional: Enable SSL for production database connection
# DB_SSL=true